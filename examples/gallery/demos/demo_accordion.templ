package demos

import (
	"github.com/geoffjay/templ-ui/daisyui"
	"github.com/geoffjay/templ-ui/examples/gallery"
	"github.com/geoffjay/templ-ui/internal/registry"
)

func init() {
	registry.Register(registry.Entry{
		Slug:        "accordion",
		Name:        "Accordion",
		Description: "Accordion is used for showing and hiding content but only one item can stay open at a time.",
		Category:    "daisyui",
		Body:        accordionBody,
	})
}

templ accordionBody() {
	@gallery.Section("Accordion using radio inputs", `@daisyui.Accordion(
	"my-accordion-1",
	[]daisyui.AccordionItem{
		{Title: "How do I create an account?", Content: "Click the \"Sign Up\" button...", Open: true},
		{Title: "I forgot my password. What should I do?", Content: "Click on \"Forgot Password\"..."},
		{Title: "How do I update my profile information?", Content: "Go to \"My Account\" settings..."},
	},
	"",
	false,
)`, daisyui.Accordion(
		"my-accordion-1",
		[]daisyui.AccordionItem{
			{Title: "How do I create an account?", Content: "Click the \"Sign Up\" button in the top right corner and follow the registration process.", Open: true},
			{Title: "I forgot my password. What should I do?", Content: "Click on \"Forgot Password\" on the login page and follow the instructions sent to your email."},
			{Title: "How do I update my profile information?", Content: "Go to \"My Account\" settings and select \"Edit Profile\" to make changes."},
		},
		"",
		false,
		false,
	))
	@gallery.Section("Accordion with arrow icon", `@daisyui.Accordion(
	"my-accordion-2",
	[]daisyui.AccordionItem{
		{Title: "How do I create an account?", Content: "Click the \"Sign Up\" button...", Open: true},
		{Title: "I forgot my password. What should I do?", Content: "Click on \"Forgot Password\"..."},
		{Title: "How do I update my profile information?", Content: "Go to \"My Account\" settings..."},
	},
	"arrow",
	false,
)`, daisyui.Accordion(
		"my-accordion-2",
		[]daisyui.AccordionItem{
			{Title: "How do I create an account?", Content: "Click the \"Sign Up\" button in the top right corner and follow the registration process.", Open: true},
			{Title: "I forgot my password. What should I do?", Content: "Click on \"Forgot Password\" on the login page and follow the instructions sent to your email."},
			{Title: "How do I update my profile information?", Content: "Go to \"My Account\" settings and select \"Edit Profile\" to make changes."},
		},
		"arrow",
		false,
		false,
	))
	@gallery.Section("Accordion with plus/minus icon", `@daisyui.Accordion(
	"my-accordion-3",
	[]daisyui.AccordionItem{
		{Title: "How do I create an account?", Content: "Click the \"Sign Up\" button...", Open: true},
		{Title: "I forgot my password. What should I do?", Content: "Click on \"Forgot Password\"..."},
		{Title: "How do I update my profile information?", Content: "Go to \"My Account\" settings..."},
	},
	"plus",
	false,
)`, daisyui.Accordion(
		"my-accordion-3",
		[]daisyui.AccordionItem{
			{Title: "How do I create an account?", Content: "Click the \"Sign Up\" button in the top right corner and follow the registration process.", Open: true},
			{Title: "I forgot my password. What should I do?", Content: "Click on \"Forgot Password\" on the login page and follow the instructions sent to your email."},
			{Title: "How do I update my profile information?", Content: "Go to \"My Account\" settings and select \"Edit Profile\" to make changes."},
		},
		"plus",
		false,
		false,
	))
	@gallery.Section("Accordion joined", `@daisyui.Accordion(
	"my-accordion-4",
	[]daisyui.AccordionItem{
		{Title: "How do I create an account?", Content: "Click the \"Sign Up\" button...", Open: true},
		{Title: "I forgot my password. What should I do?", Content: "Click on \"Forgot Password\"..."},
		{Title: "How do I update my profile information?", Content: "Go to \"My Account\" settings..."},
	},
	"arrow",
	true,
)`, daisyui.Accordion(
		"my-accordion-4",
		[]daisyui.AccordionItem{
			{Title: "How do I create an account?", Content: "Click the \"Sign Up\" button in the top right corner and follow the registration process.", Open: true},
			{Title: "I forgot my password. What should I do?", Content: "Click on \"Forgot Password\" on the login page and follow the instructions sent to your email."},
			{Title: "How do I update my profile information?", Content: "Go to \"My Account\" settings and select \"Edit Profile\" to make changes."},
		},
		"arrow",
		true,
		false,
	))
	@gallery.Section("Accordion with glass", `@daisyui.Accordion(
	"my-accordion-5",
	[]daisyui.AccordionItem{
		{Title: "How do I create an account?", Content: "Click the \"Sign Up\" button...", Open: true},
		{Title: "I forgot my password. What should I do?", Content: "Click on \"Forgot Password\"..."},
	},
	"arrow",
	true,
		true,
	)`, gallery.GlassBackdrop(daisyui.Accordion(
		"my-accordion-5",
		[]daisyui.AccordionItem{
			{Title: "How do I create an account?", Content: "Click the \"Sign Up\" button in the top right corner and follow the registration process.", Open: true},
			{Title: "I forgot my password. What should I do?", Content: "Click on \"Forgot Password\" on the login page and follow the instructions sent to your email."},
		},
		"arrow",
		true,
		true,
	)))
}
