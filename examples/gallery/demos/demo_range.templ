package demos

import (
	"github.com/geoffjay/templ-ui/daisyui"
	"github.com/geoffjay/templ-ui/examples/gallery"
	"github.com/geoffjay/templ-ui/internal/registry"
)

templ rangeBody() {
	@gallery.Section("Range", `@daisyui.Range(daisyui.RangeConfig{
	Min: "0", Max: "100", Value: "40",
})`, daisyui.Range(daisyui.RangeConfig{
		Min: "0", Max: "100", Value: "40",
	}))
	@gallery.Section("With steps and measure", `<div class="w-full max-w-xs">
	@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "25", Step: "25"})
	<div class="flex justify-between px-2.5 mt-2 text-xs">
		<span>|</span><span>|</span><span>|</span><span>|</span><span>|</span>
	</div>
	<div class="flex justify-between px-2.5 mt-2 text-xs">
		<span>1</span><span>2</span><span>3</span><span>4</span><span>5</span>
	</div>
</div>`, rangeWithSteps())
	@gallery.Section("Neutral color", `@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "neutral"})`, daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "neutral"}))
	@gallery.Section("Primary color", `@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "primary"})`, daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "primary"}))
	@gallery.Section("Secondary color", `@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "secondary"})`, daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "secondary"}))
	@gallery.Section("Accent color", `@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "accent"})`, daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "accent"}))
	@gallery.Section("Success color", `@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "success"})`, daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "success"}))
	@gallery.Section("Warning color", `@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "warning"})`, daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "warning"}))
	@gallery.Section("Info color", `@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "info"})`, daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "info"}))
	@gallery.Section("Error color", `@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "error"})`, daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Color: "error"}))
	@gallery.Section("Sizes", `<div class="flex flex-col gap-4 w-full max-w-xs">
	@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "30", Size: "xs"})
	@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Size: "sm"})
	// ... one per size
</div>`, rangeSizeRow())
	@gallery.Section("Range with custom color and no fill", `@daisyui.Range(daisyui.RangeConfig{
	Min: "0", Max: "100", Value: "40",
	Class: "text-blue-300 [--range-bg:orange] [--range-thumb:blue] [--range-fill:0]",
})`, daisyui.Range(daisyui.RangeConfig{
		Min: "0", Max: "100", Value: "40",
		Class: "text-blue-300 [--range-bg:orange] [--range-thumb:blue] [--range-fill:0]",
	}))
}

templ rangeWithSteps() {
	<div class="w-full max-w-xs">
		@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "25", Step: "25"})
		<div class="flex justify-between px-2.5 mt-2 text-xs">
			<span>|</span><span>|</span><span>|</span><span>|</span><span>|</span>
		</div>
		<div class="flex justify-between px-2.5 mt-2 text-xs">
			<span>1</span><span>2</span><span>3</span><span>4</span><span>5</span>
		</div>
	</div>
}

templ rangeSizeRow() {
	<div class="flex flex-col gap-4 w-full max-w-xs">
		@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "30", Size: "xs"})
		@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "40", Size: "sm"})
		@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "50", Size: "md"})
		@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "60", Size: "lg"})
		@daisyui.Range(daisyui.RangeConfig{Min: "0", Max: "100", Value: "70", Size: "xl"})
	</div>
}

func init() {
	registry.Register(registry.Entry{
		Slug:        "range",
		Name:        "Range slider",
		Description: "Range slider is used to select a value by sliding a handle.",
		Category:    "daisyui",
		Body:        rangeBody,
	})
}
