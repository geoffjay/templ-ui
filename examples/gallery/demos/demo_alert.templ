package demos

import (
	"github.com/geoffjay/templ-ui/daisyui"
	"github.com/geoffjay/templ-ui/examples/gallery"
	"github.com/geoffjay/templ-ui/internal/registry"
	icons "github.com/iota-uz/icons/phosphor"
)

func init() {
	registry.Register(registry.Entry{
		Slug:        "alert",
		Name:        "Alert",
		Description: "Alert informs users about important events.",
		Category:    "daisyui",
		Body:        alertBody,
	})
}

templ alertBody() {
	@gallery.Section("Alert", `@daisyui.Alert(daisyui.AlertConfig{
	Message: "12 unread messages. Tap to see.",
	Class:   "w-full",
	Icon:    templ.Raw(...),
})`, daisyui.Alert(daisyui.AlertConfig{
		Message: "12 unread messages. Tap to see.",
		Class:   "w-full",
		Icon:    icons.Info(icons.Props{Size: "24", Class: "shrink-0"}),
	}))
	@gallery.Section("Info color", `@daisyui.Alert(daisyui.AlertConfig{
	Message: "New software update available.",
	Color:   "info",
	Class:   "w-full",
	Icon:    templ.Raw(...),
})`, daisyui.Alert(daisyui.AlertConfig{
		Message: "New software update available.",
		Color:   "info",
		Class:   "w-full",
		Icon:    icons.Info(icons.Props{Size: "24", Class: "shrink-0"}),
	}))
	@gallery.Section("Success color", `@daisyui.Alert(daisyui.AlertConfig{
	Message: "Your purchase has been confirmed!",
	Color:   "success",
	Class:   "w-full",
	Icon:    templ.Raw(...),
})`, daisyui.Alert(daisyui.AlertConfig{
		Message: "Your purchase has been confirmed!",
		Color:   "success",
		Class:   "w-full",
		Icon:    icons.CheckCircle(icons.Props{Size: "24", Class: "shrink-0"}),
	}))
	@gallery.Section("Warning color", `@daisyui.Alert(daisyui.AlertConfig{
	Message: "Warning: Invalid email address!",
	Color:   "warning",
	Class:   "w-full",
	Icon:    templ.Raw(...),
})`, daisyui.Alert(daisyui.AlertConfig{
		Message: "Warning: Invalid email address!",
		Color:   "warning",
		Class:   "w-full",
		Icon:    icons.Warning(icons.Props{Size: "24", Class: "shrink-0"}),
	}))
	@gallery.Section("Error color", `@daisyui.Alert(daisyui.AlertConfig{
	Message: "Error! Task failed successfully.",
	Color:   "error",
	Class:   "w-full",
	Icon:    templ.Raw(...),
})`, daisyui.Alert(daisyui.AlertConfig{
		Message: "Error! Task failed successfully.",
		Color:   "error",
		Class:   "w-full",
		Icon:    icons.XCircle(icons.Props{Size: "24", Class: "shrink-0"}),
	}))
	@gallery.Section("Alert soft style", `<div class="flex flex-col gap-2">
	@daisyui.Alert(daisyui.AlertConfig{Message: "12 unread messages. Tap to see.", Color: "info", Style: "soft", Class: "w-full"})
	@daisyui.Alert(daisyui.AlertConfig{Message: "Your purchase has been confirmed!", Color: "success", Style: "soft", Class: "w-full"})
	// ... one per color
</div>`, alertDemoSoftRow())
	@gallery.Section("Alert outline style", `<div class="flex flex-col gap-2">
	@daisyui.Alert(daisyui.AlertConfig{Message: "12 unread messages. Tap to see.", Color: "info", Style: "outline", Class: "w-full"})
	@daisyui.Alert(daisyui.AlertConfig{Message: "Your purchase has been confirmed!", Color: "success", Style: "outline", Class: "w-full"})
	// ... one per color
</div>`, alertDemoOutlineRow())
	@gallery.Section("Alert dash style", `<div class="flex flex-col gap-2">
	@daisyui.Alert(daisyui.AlertConfig{Message: "12 unread messages. Tap to see.", Color: "info", Style: "dash", Class: "w-full"})
	@daisyui.Alert(daisyui.AlertConfig{Message: "Your purchase has been confirmed!", Color: "success", Style: "dash", Class: "w-full"})
	// ... one per color
</div>`, alertDemoDashRow())
	@gallery.Section("Alert with buttons + responsive", `@daisyui.Alert(daisyui.AlertConfig{
	Message: "we use cookies for no reason.",
	Class:   "w-full alert-vertical sm:alert-horizontal",
	Icon:    templ.Raw(...),
	Actions: alertDemoActionButtons(),
})

templ alertDemoActionButtons() {
	<div>
		@daisyui.Button(daisyui.ButtonConfig{Label: "Deny", Size: "sm"})
		@daisyui.Button(daisyui.ButtonConfig{Label: "Accept", Size: "sm", Color: "primary"})
	</div>
}`, daisyui.Alert(daisyui.AlertConfig{
		Message: "we use cookies for no reason.",
		Class:   "w-full alert-vertical sm:alert-horizontal",
		Icon:    icons.Info(icons.Props{Size: "24", Class: "shrink-0"}),
		Actions: alertDemoActionButtons(),
	}))
	@gallery.Section("Alert with title and description", `@daisyui.Alert(daisyui.AlertConfig{
	Title:   "New message!",
	Desc:    "You have 1 unread message",
	Class:   "w-full alert-vertical sm:alert-horizontal",
	Icon:    templ.Raw(...),
	Actions: daisyui.Button(daisyui.ButtonConfig{Label: "See", Size: "sm"}),
})`, daisyui.Alert(daisyui.AlertConfig{
		Title:   "New message!",
		Desc:    "You have 1 unread message",
		Class:   "w-full alert-vertical sm:alert-horizontal",
		Icon:    icons.Info(icons.Props{Size: "24", Class: "shrink-0"}),
		Actions: daisyui.Button(daisyui.ButtonConfig{Label: "See", Size: "sm"}),
	}))
	@gallery.Section("Alert with glass", `@daisyui.Alert(daisyui.AlertConfig{
	Message: "Glass: translucent, blurred surface.",
	Glass:   true,
	Class:   "w-full",
})`, gallery.GlassBackdrop(daisyui.Alert(daisyui.AlertConfig{
		Message: "Glass: translucent, blurred surface.",
		Glass:   true,
		Class:   "w-full",
	})))
}

templ alertDemoActionButtons() {
	<div>
		@daisyui.Button(daisyui.ButtonConfig{Label: "Deny", Size: "sm"})
		@daisyui.Button(daisyui.ButtonConfig{Label: "Accept", Size: "sm", Color: "primary"})
	</div>
}

templ alertDemoSoftRow() {
	<div class="flex flex-col gap-2">
		@daisyui.Alert(daisyui.AlertConfig{Message: "12 unread messages. Tap to see.", Color: "info", Style: "soft", Class: "w-full"})
		@daisyui.Alert(daisyui.AlertConfig{Message: "Your purchase has been confirmed!", Color: "success", Style: "soft", Class: "w-full"})
		@daisyui.Alert(daisyui.AlertConfig{Message: "Warning: Invalid email address!", Color: "warning", Style: "soft", Class: "w-full"})
		@daisyui.Alert(daisyui.AlertConfig{Message: "Error! Task failed successfully.", Color: "error", Style: "soft", Class: "w-full"})
	</div>
}

templ alertDemoOutlineRow() {
	<div class="flex flex-col gap-2">
		@daisyui.Alert(daisyui.AlertConfig{Message: "12 unread messages. Tap to see.", Color: "info", Style: "outline", Class: "w-full"})
		@daisyui.Alert(daisyui.AlertConfig{Message: "Your purchase has been confirmed!", Color: "success", Style: "outline", Class: "w-full"})
		@daisyui.Alert(daisyui.AlertConfig{Message: "Warning: Invalid email address!", Color: "warning", Style: "outline", Class: "w-full"})
		@daisyui.Alert(daisyui.AlertConfig{Message: "Error! Task failed successfully.", Color: "error", Style: "outline", Class: "w-full"})
	</div>
}

templ alertDemoDashRow() {
	<div class="flex flex-col gap-2">
		@daisyui.Alert(daisyui.AlertConfig{Message: "12 unread messages. Tap to see.", Color: "info", Style: "dash", Class: "w-full"})
		@daisyui.Alert(daisyui.AlertConfig{Message: "Your purchase has been confirmed!", Color: "success", Style: "dash", Class: "w-full"})
		@daisyui.Alert(daisyui.AlertConfig{Message: "Warning: Invalid email address!", Color: "warning", Style: "dash", Class: "w-full"})
		@daisyui.Alert(daisyui.AlertConfig{Message: "Error! Task failed successfully.", Color: "error", Style: "dash", Class: "w-full"})
	</div>
}
