package demos

import (
	"github.com/geoffjay/templ-ui/daisyui"
	"github.com/geoffjay/templ-ui/examples/gallery"
	"github.com/geoffjay/templ-ui/internal/registry"
)

templ textRotateBody() {
	@gallery.Section("Rotates through 3 words in 10 seconds", `@daisyui.TextRotate(daisyui.TextRotateConfig{
	Lines: []daisyui.TextRotateLine{
		{Text: "ONE"},
		{Text: "TWO"},
		{Text: "THREE"},
	},
})`, daisyui.TextRotate(daisyui.TextRotateConfig{
		Lines: []daisyui.TextRotateLine{
			{Text: "ONE"},
			{Text: "TWO"},
			{Text: "THREE"},
		},
	}))
	@gallery.Section("Rotating 6 words (big, centered)", `@daisyui.TextRotate(daisyui.TextRotateConfig{
	Class:      "max-md:text-3xl text-7xl",
	InnerClass: "justify-items-center",
	Lines: []daisyui.TextRotateLine{
		{Text: "DESIGN"},
		{Text: "DEVELOP"},
		{Text: "DEPLOY"},
		{Text: "SCALE"},
		{Text: "MAINTAIN"},
		{Text: "REPEAT"},
	},
})`, daisyui.TextRotate(daisyui.TextRotateConfig{
		Class:      "max-md:text-3xl text-7xl",
		InnerClass: "justify-items-center",
		Lines: []daisyui.TextRotateLine{
			{Text: "DESIGN"},
			{Text: "DEVELOP"},
			{Text: "DEPLOY"},
			{Text: "SCALE"},
			{Text: "MAINTAIN"},
			{Text: "REPEAT"},
		},
	}))
	@gallery.Section("Rotating words in a sentence", `<div class="text-lg">
	Providing AI Agents for
	@daisyui.TextRotate(daisyui.TextRotateConfig{
		Lines: []daisyui.TextRotateLine{
			{Text: "Designers", Class: "bg-teal-400 text-teal-800 px-2"},
			{Text: "Developers", Class: "bg-red-400 text-red-800 px-2"},
			{Text: "Managers", Class: "bg-blue-400 text-blue-800 px-2"},
		},
	})
</div>`, textRotateInSentence())
	@gallery.Section("Custom duration (6s)", `@daisyui.TextRotate(daisyui.TextRotateConfig{
	Class:      "max-md:text-3xl text-7xl",
	Duration:   6000,
	InnerClass: "justify-items-center",
	Lines: []daisyui.TextRotateLine{
		{Text: "BLAZING"},
		{Text: "FAST ▶︎▶︎", Class: "font-bold italic px-2"},
	},
})`, daisyui.TextRotate(daisyui.TextRotateConfig{
		Class:      "max-md:text-3xl text-7xl",
		Duration:   6000,
		InnerClass: "justify-items-center",
		Lines: []daisyui.TextRotateLine{
			{Text: "BLAZING"},
			{Text: "FAST ▶︎▶︎", Class: "font-bold italic px-2"},
		},
	}))
	@gallery.Section("Custom line height", `@daisyui.TextRotate(daisyui.TextRotateConfig{
	Class:      "max-md:text-3xl text-7xl leading-[2]",
	InnerClass: "justify-items-center",
	Lines: []daisyui.TextRotateLine{
		{Text: "📐 DESIGN"},
		{Text: "⌨️ DEVELOP"},
		{Text: "🌎 DEPLOY"},
		{Text: "🌱 SCALE"},
		{Text: "🔧 MAINTAIN"},
		{Text: "♻️ REPEAT"},
	},
})`, daisyui.TextRotate(daisyui.TextRotateConfig{
		Class:      "max-md:text-3xl text-7xl leading-[2]",
		InnerClass: "justify-items-center",
		Lines: []daisyui.TextRotateLine{
			{Text: "📐 DESIGN"},
			{Text: "⌨️ DEVELOP"},
			{Text: "🌎 DEPLOY"},
			{Text: "🌱 SCALE"},
			{Text: "🔧 MAINTAIN"},
			{Text: "♻️ REPEAT"},
		},
	}))
}

templ textRotateInSentence() {
	<div class="text-lg">
		Providing AI Agents for
		@daisyui.TextRotate(daisyui.TextRotateConfig{
			Lines: []daisyui.TextRotateLine{
				{Text: "Designers", Class: "bg-teal-400 text-teal-800 px-2"},
				{Text: "Developers", Class: "bg-red-400 text-red-800 px-2"},
				{Text: "Managers", Class: "bg-blue-400 text-blue-800 px-2"},
			},
		})
	</div>
}

func init() {
	registry.Register(registry.Entry{
		Slug:        "text-rotate",
		Name:        "Text Rotate",
		Description: "Text Rotate shows up to 6 lines of text, one at a time, with an infinite loop animation. The animation pauses on hover.",
		Category:    "daisyui",
		Body:        textRotateBody,
	})
}
